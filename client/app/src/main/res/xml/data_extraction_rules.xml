<?xml version="1.0" encoding="utf-8"?><!--
   Backup and device transfer on Android 12 and newer
   (https://developer.android.com/about/versions/12/backup-restore#xml-changes).
   The signed-in account (DeviceAccountStore) is left out, so its token stays on this device.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="account.xml"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="account.xml"/>
    </device-transfer>
</data-extraction-rules>
