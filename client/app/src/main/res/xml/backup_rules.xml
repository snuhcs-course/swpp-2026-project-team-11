<?xml version="1.0" encoding="utf-8"?><!--
   Backup on Android 11 and older (https://developer.android.com/guide/topics/data/autobackup).
   Everything is backed up except the signed-in account (DeviceAccountStore): its token
   stays on this device. data_extraction_rules.xml does the same for Android 12 and newer.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="account.xml"/>
</full-backup-content>
