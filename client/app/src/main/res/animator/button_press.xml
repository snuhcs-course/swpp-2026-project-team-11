<?xml version="1.0" encoding="utf-8"?>
<!-- A button sinks slightly while pressed and stays down while its request runs
     (MainActivity marks the tapped button as selected), then springs back. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <set>
            <objectAnimator android:duration="90" android:propertyName="scaleX" android:valueTo="0.97" android:valueType="floatType" />
            <objectAnimator android:duration="90" android:propertyName="scaleY" android:valueTo="0.97" android:valueType="floatType" />
        </set>
    </item>
    <item android:state_selected="true">
        <set>
            <objectAnimator android:duration="90" android:propertyName="scaleX" android:valueTo="0.97" android:valueType="floatType" />
            <objectAnimator android:duration="90" android:propertyName="scaleY" android:valueTo="0.97" android:valueType="floatType" />
        </set>
    </item>
    <item>
        <set>
            <objectAnimator android:duration="180" android:interpolator="@android:interpolator/overshoot" android:propertyName="scaleX" android:valueTo="1" android:valueType="floatType" />
            <objectAnimator android:duration="180" android:interpolator="@android:interpolator/overshoot" android:propertyName="scaleY" android:valueTo="1" android:valueType="floatType" />
        </set>
    </item>
</selector>
