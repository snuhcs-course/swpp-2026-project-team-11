<!-- AI-generated: written with Claude (Anthropic) and reviewed by the team. -->
<resources>

    <style name="Base.Theme.Metchu" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <!-- the selected meal in the toggle group -->
        <item name="colorSecondaryContainer">@color/primary_soft</item>
        <item name="colorOnSecondaryContainer">@color/primary</item>
        <item name="colorSurface">@color/surface_card</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="colorOutline">@color/hairline_strong</item>
        <item name="android:colorBackground">@color/canvas</item>
        <item name="android:statusBarColor">@color/canvas</item>
        <item name="android:navigationBarColor">@color/canvas</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.Metchu" parent="Base.Theme.Metchu" />

    <!-- Small uppercase label above a title. -->
    <style name="Text.Caption" parent="">
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/muted</item>
    </style>

    <!-- The question, or the dish being proposed. -->
    <style name="Text.Headline" parent="">
        <item name="android:textSize">26sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
        <item name="android:textColor">@color/ink</item>
    </style>

    <style name="Text.Title" parent="">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/ink</item>
    </style>

    <style name="Text.Body" parent="">
        <item name="android:textSize">15sp</item>
        <item name="android:lineSpacingMultiplier">1.35</item>
        <item name="android:textColor">@color/body</item>
    </style>

    <style name="Button.Primary" parent="Widget.Material3.Button">
        <item name="android:minHeight">52dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/button_primary_text</item>
        <item name="android:stateListAnimator">@animator/button_press</item>
        <item name="backgroundTint">@color/button_primary_bg</item>
        <item name="cornerRadius">12dp</item>
    </style>

    <style name="Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">52dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/button_secondary_text</item>
        <item name="android:stateListAnimator">@animator/button_press</item>
        <item name="backgroundTint">@color/button_secondary_bg</item>
        <item name="cornerRadius">12dp</item>
        <item name="strokeColor">@color/button_secondary_stroke</item>
    </style>

    <style name="Button.Quiet" parent="Widget.Material3.Button.TextButton">
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/button_quiet_text</item>
        <item name="android:stateListAnimator">@animator/button_press</item>
    </style>
</resources>
